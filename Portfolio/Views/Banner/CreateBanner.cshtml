@model Banner
@{
    ViewData["Title"] = "Banner Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form asp-action="CreateBanner" asp-controller="Banner" method="post" class="glass-card p-4">
    @Html.AntiForgeryToken()

  
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label class="form-label fw-bold" asp-for="ImageUrl">Görsel URL (Image Url)</label>
        <input type="text" class="form-control" asp-for="ImageUrl" placeholder="https://..." required>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold" asp-for="Title">Başlık</label>
        <input type="text" class="form-control" asp-for="Title" placeholder="Banner başlığı" required>
    </div>

    <div class="mb-4">
        <label class="form-label fw-bold" asp-for="Description">Açıklama</label>
        <textarea asp-for="Description" class="form-control" rows="6" placeholder="Açıklama metni..." required style="min-height: 140px;"></textarea>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary px-4 py-2">
            <i class="fa-solid fa-floppy-disk me-1"></i> Ekle
        </button>
    </div>
</form>