@model List<UserMessage>
@{
    ViewData["Title"] = "Kullanıcı Mesajları";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


<div class="container-fluid p-3">
    <h4 class="fw-bold mb-4 text-dark">Gelen Mesajlar</h4>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="row align-items-center g-3">
                            
                            <!-- Adı ve Email -->
                            <div class="col-12 col-md-3">
                                <h6 class="fw-bold text-dark mb-1">@item.Name</h6>
                                <small class="text-muted">@item.Email</small>
                            </div>

                            <!-- Mesaj İçeriği -->
                            <div class="col-12 col-md-4">
                                <p class="text-body mb-0 text-truncate">
                                    @item.MessageBody
                                </p>
                            </div>

                            <!-- Durum Rozeti (Okundu: Siyah, Okunmadı: Kırmızı) -->
                            <div class="col-6 col-md-2 text-md-center">
                                @if (item.IsRead)
                                {
                                    <span class="badge bg-dark text-white px-3 py-2 fw-semibold">
                                        Okundu
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-white px-3 py-2 fw-semibold">
                                        Okunmadı
                                    </span>
                                }
                            </div>

                            <!-- İşlem Butonları (Mavi Detay ve Kırmızı Sil) -->
                            <div class="col-6 col-md-3 text-end d-flex justify-content-end gap-2">
                                <a href="/UserMessage/UserMessageDetail/@item.Id" class="btn btn-primary btn-sm px-3 fw-semibold">
                                    Detay
                                </a>
                                <a href="/UserMessage/DeleteUserMessage/@item.Id" class="btn btn-danger btn-sm px-3 fw-semibold" onclick="return confirm('Bu mesajı silmek istediğinize emin misiniz?');">
                                    Sil
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-secondary text-center mb-0">
            Henüz mesaj bulunmuyor.
        </div>
    }
</div>