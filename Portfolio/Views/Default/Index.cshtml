
@{
    Layout = null;
}

<!DOCTYPE html>

<html class="dark scroll-smooth" lang="en">
@* head *@
@await Component.InvokeAsync("_DefaultHead")
<body class="bg-background text-on-background antialiased selection:bg-primary/30 selection:text-primary">
    <!-- TopNavBar -->
    <nav class="bg-background/80 dark:bg-background/80 backdrop-blur-xl border-b border-outline-variant/10 fixed top-0 w-full z-50">
        <div class="flex justify-between items-center max-w-[1200px] mx-auto px-gutter h-20">
            <a class="font-headline-md text-headline-md font-extrabold tracking-tighter text-on-background dark:text-on-background cursor-pointer active:scale-95" href="#">CİHAN.DEV</a>
            <div class="hidden md:flex items-center gap-stack-lg">
                <a class="text-on-surface-variant dark:text-on-surface-variant hover:text-primary transition-colors duration-300 font-body-md text-body-md" href="#about">Hakkımda</a>
                <a class="text-on-surface-variant dark:text-on-surface-variant hover:text-primary transition-colors duration-300 font-body-md text-body-md" href="#services">Hizmetlerim</a>
                <a class="text-on-surface-variant dark:text-on-surface-variant hover:text-primary transition-colors duration-300 font-body-md text-body-md" href="#portfolio">Projelerim</a>
                <a class="text-on-surface-variant dark:text-on-surface-variant hover:text-primary transition-colors duration-300 font-body-md text-body-md" href="#experience">Deneyimlerim</a>
                <a class="text-on-surface-variant dark:text-on-surface-variant hover:text-primary transition-colors duration-300 font-body-md text-body-md" href="#contact">İletişim</a>
            </div>
            <a class="hidden md:inline-flex items-center justify-center px-6 py-3 bg-primary text-on-primary rounded-DEFAULT font-label-sm text-label-sm hover:opacity-90 transition-opacity cursor-pointer active:scale-95" href="#contact">Hadi Konuşalım</a>
            <!-- Mobile Menu Button -->
            <button class="md:hidden text-on-background">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">menu</span>
            </button>
        </div>
    </nav>
    <main class="pt-20">
        <!-- Hero Section -->
        @await Component.InvokeAsync("_DefaultHeroSlider")
        <!-- About Section -->
        @await Component.InvokeAsync("_DefaultAbout")
        <!-- Experience  Education Section -->
        <section class="py-section-padding-mobile md:py-section-padding-desktop px-gutter relative" id="experience">
            <div class="max-w-container-max mx-auto">
                <div class="text-center mb-stack-lg">
                    <h2 class="font-headline-md text-headline-md text-on-background">Geçmiş</h2>
                    <p class="font-body-md text-body-md text-on-surface-variant mt-2">İş Ve Akademik Geçmişim.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-lg">
                    <!-- Experience -->
                    @await Component.InvokeAsync("_DefaultExperience")
                    <!-- Education -->
                    @await Component.InvokeAsync("_DefaultEducation")
                </div>
            </div>
        </section>
       
        <!-- Services Section -->
        <section class="py-section-padding-mobile md:py-section-padding-desktop px-gutter relative bg-surface-container-lowest" id="services">
            <div class="max-w-container-max mx-auto">
                <h2 class="font-headline-md text-headline-md text-on-background mb-stack-lg">Hizmetlerim</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-stack-lg">
                    <!-- Service 1 -->
                    @await Component.InvokeAsync("_DefaultService")
                
                </div>
            </div>
        </section>
        <!-- Portfolio Slider Section -->
        <section class="py-section-padding-mobile md:py-section-padding-desktop px-gutter relative overflow-hidden" id="portfolio">
            <div class="max-w-container-max mx-auto mb-stack-lg flex justify-between items-end">
                <div>
                    <h2 class="font-headline-md text-headline-md text-on-background">Çalışmalarım</h2>
                    <p class="font-body-md text-body-md text-on-surface-variant mt-2">Yapmış olduğum projeleri inceleyebilirsiniz.</p>
                </div>
                <div class="hidden md:flex gap-4">
                    <button class="p-2 rounded-full border border-outline hover:bg-surface-variant transition-colors text-on-background" id="prev-btn">
                        <span class="material-symbols-outlined">arrow_back</span>
                    </button>
                    <button class="p-2 rounded-full border border-outline hover:bg-surface-variant transition-colors text-on-background" id="next-btn">
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </div>
            </div>
            <div class="flex gap-stack-md overflow-x-auto hide-scrollbar pb-8 px-gutter md:px-0 max-w-container-max mx-auto snap-x snap-mandatory" id="slider-container">
                <!-- Project 1 -->
                @await Component.InvokeAsync("_DefaultProject")
            </div>
        </section>
        <!-- Testimonials Section -->
        @await Component.InvokeAsync("_DefaultTestimonial")
        <!-- Contact Section -->
        <section class="py-section-padding-mobile md:py-section-padding-desktop px-gutter relative bg-surface-container-lowest" id="contact">
            <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-stack-lg">
                @await Component.InvokeAsync("_DefaultContactInfo")
                @await Component.InvokeAsync("_DefaultUserMessage")
            </div>
        </section>
        <!-- Footer -->
        @await Component.InvokeAsync("_DefaultFooter")
    </main>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
        const slider = document.getElementById('slider-container');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');

        if(slider && prevBtn && nextBtn) {
        const getScrollAmount = () => {
        const card = slider.querySelector('.snap-center');
        if (!card) return 0;
        const cardWidth = card.offsetWidth;
        const gap = parseFloat(getComputedStyle(slider).gap) || 0;
        return cardWidth + gap;
        };

        prevBtn.addEventListener('click', () => {
        slider.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', () => {
        slider.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        });
        }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body></html>