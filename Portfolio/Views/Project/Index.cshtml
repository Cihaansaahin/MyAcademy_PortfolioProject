@model List<Project>
@{
    ViewData["Title"] = "Projelerim";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4">
      
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h5 class="fw-bold text-dark m-0">Proje Listesi</h5>
                <p class="text-muted small m-0">Portfolyonuzda sergilenen projeleri buradan yönetebilirsiniz.</p>
            </div>
            <a href="/Project/CreateProject" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3">
                <i class="fa-solid fa-plus"></i> Yeni Proje Oluştur
            </a>
        </div>

       
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">Görsel</th>
                        <th>Proje Adı</th>
                        <th>Açıklama</th>
                        <th>GitHub</th>
                        <th class="text-end" style="width: 160px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" class="rounded-2 object-fit-cover" style="width: 48px; height: 48px;" alt="@item.Name" />
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.Name</span>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @(item.Description?.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.GitHubUrl))
                                    {
                                        <a href="@item.GitHubUrl" target="_blank" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1">
                                            <i class="fa-brands fa-github"></i> GitHub
                                        </a>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="/Project/UpdateProject/@item.Id" class="btn btn-outline-secondary" title="Güncelle">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <button onclick="deleteProject(@item.Id)" class="btn btn-outline-danger" title="Sil">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fa-regular fa-folder-open fs-3 d-block mb-2"></i>
                                Henüz bir proje eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function deleteProject(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning", // 'uyarı!' parametresi hatalıydı, 'warning' olarak düzeltildi
            showCancelButton: true,
            confirmButtonColor: "#dc3545",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/Project/DeleteProject/" + id;
            }
        });
    }
</script>