@model List<Service>
@*
    Default Service
*@

@foreach (var item in Model)
{
    <div class="glass-card p-stack-lg rounded-xl flex flex-col gap-stack-sm hover:-translate-y-2 transition-transform duration-300">
        <span class="material-symbols-outlined text-primary text-4xl mb-stack-sm" style="font-variation-settings: 'FILL' 0;">@item.Icon</span>
        <h3 class="font-body-lg text-body-lg font-semibold text-on-background">@item.Title</h3>
        <p class="font-body-md text-body-md text-on-surface-variant">@item.Description</p>
    </div>
}
