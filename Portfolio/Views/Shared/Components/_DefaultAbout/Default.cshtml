@model List<About>

<section class="py-section-padding-mobile md:py-section-padding-desktop px-gutter relative bg-surface-container-lowest" id="about">
    <div class="max-w-container-max mx-auto flex flex-col gap-stack-xl">
        
        @foreach (var item in Model)
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-lg items-center">
                
                @* Görsel *@
                <div class="relative w-full aspect-square rounded-xl overflow-hidden glass-card">
                    <img src="@item.ImageUrl" 
                         alt="@item.Title" 
                         class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500" />
                </div>

                @* İçerik ve Yetenekler *@
                <div class="flex flex-col gap-stack-md">
                    <div>
                        <h2 class="font-headline-md text-headline-md text-on-background mb-stack-xs">
                            @item.Title
                        </h2>
                        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                            @item.Description
                        </p>
                    </div>

                    @* Sadece Aktif Olan Yetenekler *@
                    @if (item.Skills != null && item.Skills.Any(s => s.IsActive))
                    {
                        var activeSkillNames = item.Skills
                            .Where(s => s.IsActive)
                            .Select(s => s.Name);

                        <div class="pt-stack-sm border-t border-outline-variant/30">
                            <h3 class="font-label-sm text-label-sm text-primary mb-1 uppercase tracking-wider">
                                Yetenekler
                            </h3>
                            <p class="font-body-md text-body-md text-on-surface-variant">
                                @string.Join(", ", activeSkillNames)
                            </p>
                        </div>
                    }
                </div>

            </div>
        }

    </div>
</section>