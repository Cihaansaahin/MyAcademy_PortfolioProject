@model List<Project>?

@*
    Default Project
*@

@if (Model != null)
{
    foreach (var item in Model)
    {
        var stacks = item?.ProjectTechStacks;
        <div class="min-w-[300px] md:min-w-[400px] lg:min-w-[500px] snap-center glass-card rounded-xl overflow-hidden group">
            <div class="aspect-video overflow-hidden relative">
                <img alt="@item?.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@item?.ImageUrl" />
                <div class="absolute inset-0 bg-background/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                    <a class="px-6 py-2 bg-primary text-on-primary rounded-DEFAULT font-label-sm text-label-sm" href="#">Projeyi Görüntüle</a>
                </div>
            </div>
            <div class="p-stack-md">
                <h3 class="font-body-lg text-body-lg font-semibold text-on-background mb-2">@(item?.Name ?? string.Empty)</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mb-4 line-clamp-2">@(item?.Description ?? string.Empty)</p>
                <div class="flex flex-wrap gap-2">
                    @if (stacks != null)
                    {
                        foreach (var tech in stacks)
                        {
                            <span class="px-3 py-1 bg-surface-variant rounded-full font-label-sm text-label-sm text-on-surface">@(tech?.TechStack?.Name ?? string.Empty)</span>
                        }
                    }
                </div>
            </div>
        </div>
    }
}