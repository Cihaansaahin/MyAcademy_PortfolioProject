@*
   Admin Layout Sidebar
*@

<aside class="w-sidebar-width h-screen fixed left-0 top-0 bg-surface-lowest border-r border-outline-variant flex flex-col py-lg z-50">
    <div class="px-md mb-xl">
        <h2 class="font-h2 text-h2 font-bold text-primary">Portfolyo Admin Paneli</h2>
        <p class="text-on-surface-variant font-label-sm mt-xs">Yönetim Sayfası</p>
    </div>
    <nav class="flex-1 space-y-1">
        <!-- Dashboard (Inactive) -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="#">
            <span class="material-symbols-outlined">dashboard</span>
            <span class="font-label-md text-label-md">Dashboard</span>
        </a>

        <!-- Banner / Karşılama -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Banner/Index">
            <span class="material-symbols-outlined">view_carousel</span>
            <span class="font-label-md text-label-md">Banner</span>
        </a>

        <!-- Projects (Active) -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Project/Index">
            <span class="material-symbols-outlined" >folder_open</span>
            <span class="font-label-md text-label-md font-semibold">Projelerim</span>
        </a>
        <!-- Categories -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/About/Index">
            <span class="material-symbols-outlined">category</span>
            <span class="font-label-md text-label-md">Hakkımızda</span>
        </a>
      
        <!-- Deneyimlerim -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Experience/Index">
            <span class="material-symbols-outlined">work</span>
            <span class="font-label-md text-label-md">Deneyimlerim</span>
        </a>

        <!-- Eğitimlerim -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Education/Index">
            <span class="material-symbols-outlined">school</span>
            <span class="font-label-md text-label-md">Eğitimlerim</span>
        </a>

        <!-- Hizmetlerim -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Service/Index">
            <span class="material-symbols-outlined">design_services</span>
            <span class="font-label-md text-label-md">Hizmetlerim</span>
        </a>

        <!-- Teknolojiler (TechStack) -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/ProjectTechStacks/Index">
            <span class="material-symbols-outlined">layers</span>
            <span class="font-label-md text-label-md">Teknolojiler</span>
        </a>

        <!-- Messages -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/UserMessage/Index">
            <span class="material-symbols-outlined">mail</span>
            <span class="font-label-md text-label-md">Gelen Mesajlar</span>
        </a>

       
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Skill/Index">
            <span class="material-symbols-outlined">star</span>
            <span class="font-label-md text-label-md">Yetenekler</span>
        </a>

        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Testimonial/Index">
            <span class="material-symbols-outlined">chat_bubble</span>
            <span class="font-label-md text-label-md">Bahsetmeler</span>
        </a>

        <!-- İletişim Bilgileri -->
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/ContactInfo/Index">
            <span class="material-symbols-outlined">call</span>
            <span class="font-label-md text-label-md">İletişim Bilgileri</span>
        </a>

        
        <a class="flex items-center gap-md px-md py-sm text-on-surface-variant hover:bg-surface-container-highest transition-colors duration-200 cursor-pointer active:opacity-80" href="/Auth/Logout">
            <span class="material-symbols-outlined">logout</span>
            <span class="font-label-md text-label-md">Çıkış Yap </span>
        </a>
    </nav>
    <div class="mt-auto px-md flex items-center gap-md pt-lg border-t border-outline-variant">
