@model List<Skill>
@{
     ViewData["Title"] = "Yetenekler";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}
<div class="container-fluid p-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-dark mb-0">Yeteneklerim</h4>
        <a href="/Skill/CreateSkill" class="btn btn-primary fw-semibold px-3">
            <i class="fa-solid fa-plus me-1"></i> Yetenek Ekle
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="row align-items-center g-3">
                            
                            <!-- Yetenek Adı -->
                            <div class="col-12 col-md-5">
                                <h6 class="fw-bold text-dark mb-0">@item.Name</h6>
                            </div>

                            <!-- Durum (Aktif / Pasif) -->
                            <div class="col-6 col-md-3 text-md-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success text-white px-3 py-2 fw-semibold">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-white px-3 py-2 fw-semibold">
                                        Pasif
                                    </span>
                                }
                            </div>

                            <!-- İşlem Butonları -->
                            <div class="col-6 col-md-4 text-end d-flex justify-content-end gap-2">
                                <a href="/Skill/UpdateSkill/@item.Id" class="btn btn-primary btn-sm px-3 fw-semibold" title="Düzenle">
                                    Düzenle
                                </a>
                                <button onclick="deleteSkill(@item.Id)" class="btn btn-danger btn-sm px-3 fw-semibold" title="Sil">
                                    Sil
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-secondary text-center mb-0">
            Henüz eklenmiş bir yetenek bulunmamaktadır.
        </div>
    }
</div>

<script>
    function deleteSkill(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlem geri alınamaz!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dc3545",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Evet, sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/Skill/DeleteSkill/" + id;
            }
        });
    }
</script>